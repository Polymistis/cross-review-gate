#!/bin/sh
# crg-dispatch-tree-handoff-v1
#
# Adversarial review gate - every commit must pass review before it lands.
# See AGENTS.md "Convergence Loop" section for the workflow.
#
# Installed via: bootstrap.ps1 (sets up a per-clone dispatcher at
#                .git/hooks/pre-commit that delegates to this script
#                after verifying the script exists in the working tree
#                AND is tracked in HEAD). Do NOT install via
#                `git config core.hooksPath scripts/git-hooks` directly:
#                a versioned core.hooksPath leaves `git rm scripts/git-hooks/
#                pre-commit` as a silent gate-removal bypass; the
#                dispatcher closes that hole by living per-clone outside
#                the working tree.
#
# DUAL-BACKEND CROSS-REVIEW:
#   REVIEW_BACKEND declares routing intent and the preferred initial reviewer:
#     codex             - prefer scripts/codex/auto-review.ps1 (GPT-5.5 reviews)
#     claude            - prefer scripts/claude/auto-review.ps1 (Claude reviews)
#     both              - run a codex-preferred leg first; ONLY if that leg
#                         passes, also run a claude-preferred leg. SHORT-CIRCUITS
#                         on first-leg failure (no point burning a second leg's
#                         tokens on a commit that cannot land).
#   A preferred leg may be fulfilled by the other backend only through the
#   positively-identified token-exhaustion routing described below.
#   The committing agent declares itself by setting the env var before
#   `git commit` -- typically each agent sets the OTHER's backend so the
#   review is cross-author (Claude commit -> Codex review; Codex commit
#   -> Claude review). REVIEW_BACKEND is REQUIRED -- bare `git commit`
#   without an explicit setting is rejected, so a forgotten env var
#   cannot silently route a commit to self-review. The commit wrappers
#   set REVIEW_BACKEND for you; use them as the default path.
#
# TOKEN-EXHAUSTION FALLBACK (operator fallback ruling 2026-08-22): a
#   wrapper exit 4 means POSITIVELY-IDENTIFIED token exhaustion (the
#   wrapper wrote a durable .exhaustion.json sidecar; anything ambiguous
#   stays exit 3, fail-closed, never fallback-eligible). Each review LEG
#   then falls back ONCE to the other backend (run_leg). Cross-review is
#   preferred; a self-review produced by the fallback is accepted over a
#   stalled gate. Successful dispatch is provider-transparent at the caller
#   boundary: every backend invocation writes to a run-owned transcript, a
#   successful direct review and a successful fallback expose the same generic
#   start/PASS shape, and provider/exhaustion identity remains in the durable
#   verdict and exhaustion artifacts. Failed dispatch replays the involved
#   transcripts before its fail-closed diagnostic. In both-mode the legs fall
#   back independently, including for commit-wrapper edits. The operator's
#   2026-09-07 ruling requires completed reviews, not distinct providers;
#   separate legs retain separate verdicts for the same pinned candidate. A
#   codex->claude fallback is refused up front when the staged change
#   touches the configured CROSS_REVIEW_CONSISTENCY_DOC (the claude
#   wrapper fails closed on any diff touching it -- the attempt would be
#   burned on a guaranteed refusal).
#
# Security: when staged changes touch a backend's wrapper or the shared
# prompt template, THAT backend's wrapper + prompt run from HEAD's
# trusted versions extracted to a tempdir - never from the staged
# candidate version. So a commit cannot stage a weakened wrapper or
# prompt and have that weakened version approve itself.
#
# Trust chain for this hook script itself: bootstrap.ps1 installs a
# per-clone dispatcher at .git/hooks/pre-commit that captures the exact
# HEAD:scripts/git-hooks/pre-commit blob into a shell-owned buffer,
# verifies the buffer's byte length and blob OID, and evaluates THAT
# buffer in a fixed /bin/sh subshell (not the working-tree copy or an
# executable temp file). So a staged edit to this hook is reviewed by
# the verified trusted HEAD buffer (which carries this hook's previous
# version) -- not by the working-tree candidate. This closes
# the staged-no-op-replacement bypass that an in-tree-only install
# would leave open. Listing this hook in each backend's REVIEW_INFRA
# additionally routes the staged change through the backend's
# adversarial review, so a hook edit gets both (a) executed under
# HEAD's last-good logic and (b) flagged for review against HEAD's
# wrapper + prompt. See docs/audit-protocol.md "How the audit ships"
# for the audit recommendations.
#
# To skip this hook for a one-off legitimate reason (rare), set
# CROSS_REVIEW_SKIP=1 in the environment. NEVER use `git commit --no-verify`.
# The skip variable exists so the bypass is explicit, recorded in the fixed
# local audit ref, and visible.
# Bootstrap of the review infrastructure itself necessarily uses this skip
# because HEAD has no trusted version to source from yet.

ensure_unix_tool_path() {
  # Git for Windows hooks launched from PowerShell can inherit /cmd without
  # /usr/bin. This hook depends on POSIX tools from /usr/bin (env, mktemp,
  # find, rm, grep, sed, head, tr), so repair PATH before any such call.
  for d in /usr/bin /bin; do
    if [ -d "$d" ]; then
      case ":$PATH:" in
        *":$d:"*) ;;
        *) PATH="$d:$PATH" ;;
      esac
    fi
  done
  export PATH
}
ensure_unix_tool_path

# Git replacement refs rewrite commit/tree/blob reads without changing the
# object IDs printed by callers. Windows process blocks can carry multiple
# case-variant spellings, so named assignment cannot establish which value a
# native Git child consumes. Remove every raw spelling, install one canonical
# entry, and verify the raw block before the first Git command. Raw entries
# remain inside the pipe parser; only matching variable names cross into the
# parent shell, and no environment snapshot reaches disk.
crg_no_replace_environment() {
  env -0
}
crg_no_replace_stream() {
  crg_no_replace_environment
  _crg_nro_stream_status=$?
  printf '__CRG_NRO_ENUM_STATUS_%s\0' "$_crg_nro_stream_status"
}
crg_no_replace_parse() {
  _crg_nro_action=$1
  case "$_crg_nro_action" in
    names|verify) ;;
    *) return 1 ;;
  esac
  crg_no_replace_stream | (
    _crg_nro_seen_status=0
    _crg_nro_count=0
    _crg_nro_canonical=0
    while :; do
      _crg_nro_entry=
      IFS= read -r -d '' _crg_nro_entry
      _crg_nro_read_status=$?
      if [ "$_crg_nro_read_status" -ne 0 ]; then
        [ -z "$_crg_nro_entry" ] || exit 1
        break
      fi
      case "$_crg_nro_entry" in
        *=*)
          [ "$_crg_nro_seen_status" -eq 0 ] || exit 1
          _crg_nro_name=${_crg_nro_entry%%=*}
          case "$_crg_nro_name" in
            [Gg][Ii][Tt]_[Nn][Oo]_[Rr][Ee][Pp][Ll][Aa][Cc][Ee]_[Oo][Bb][Jj][Ee][Cc][Tt][Ss])
              _crg_nro_count=$((_crg_nro_count + 1))
              if [ "$_crg_nro_entry" = "GIT_NO_REPLACE_OBJECTS=1" ]; then
                _crg_nro_canonical=$((_crg_nro_canonical + 1))
              fi
              if [ "$_crg_nro_action" = "names" ]; then
                printf '%s\n' "$_crg_nro_name" || exit 1
              fi
              ;;
          esac
          ;;
        __CRG_NRO_ENUM_STATUS_0)
          [ "$_crg_nro_seen_status" -eq 0 ] || exit 1
          _crg_nro_seen_status=1
          ;;
        __CRG_NRO_ENUM_STATUS_*)
          exit 1
          ;;
        *)
          exit 1
          ;;
      esac
    done
    [ "$_crg_nro_seen_status" -eq 1 ] || exit 1
    if [ "$_crg_nro_action" = "verify" ]; then
      [ "$_crg_nro_count" -eq 1 ] && [ "$_crg_nro_canonical" -eq 1 ] || exit 1
    fi
    exit 0
  )
  _crg_nro_parse_status=$?
  unset _crg_nro_action
  return "$_crg_nro_parse_status"
}
crg_set_no_replace_singleton() {
  if ! _crg_nro_names=$(crg_no_replace_parse names); then return 1; fi
  unset GIT_NO_REPLACE_OBJECTS || return 1
  _crg_nro_saved_ifs=$IFS
  IFS='
'
  for _crg_nro_name in $_crg_nro_names; do
    case "$_crg_nro_name" in
      [Gg][Ii][Tt]_[Nn][Oo]_[Rr][Ee][Pp][Ll][Aa][Cc][Ee]_[Oo][Bb][Jj][Ee][Cc][Tt][Ss])
        unset "$_crg_nro_name" || {
          IFS=$_crg_nro_saved_ifs
          return 1
        }
        ;;
      *)
        IFS=$_crg_nro_saved_ifs
        return 1
        ;;
    esac
  done
  IFS=$_crg_nro_saved_ifs
  GIT_NO_REPLACE_OBJECTS=1
  export GIT_NO_REPLACE_OBJECTS || return 1
  if ! crg_no_replace_parse verify; then return 1; fi
  unset _crg_nro_names _crg_nro_name _crg_nro_saved_ifs _crg_nro_parse_status
  return 0
}
if ! crg_set_no_replace_singleton; then
  echo "[pre-commit] ERROR: could not establish exactly one canonical GIT_NO_REPLACE_OBJECTS=1 entry before repository inspection; refusing." >&2
  exit 1
fi

# Grafts and shallow-file overrides alter parent/range proofs independently of
# replacement refs. Attribute-source selectors can also replace text diffs with
# binary summaries or change repository attribute resolution. Git for Windows
# accepts case-variant environment names, so named shell lookups are incomplete:
# enumerate raw names case-insensitively, without evaluating any value, and fail
# closed if enumeration itself fails.
crg_git_selector_state() {
  _crg_gs_dump=$(env 2>/dev/null) || return 2
  printf '%s\n' "$_crg_gs_dump" | LC_ALL=C awk -F= '
    BEGIN { found = 0 }
    {
      name = tolower($1)
      if (name == "git_graft_file" || name == "git_shallow_file" ||
          name == "git_attr_source" || name == "git_attr_nosystem" ||
          name == "git_reference_backend") found = 1
    }
    END { exit(found ? 0 : 1) }
  '
  _crg_gs_state_rc=$?
  unset _crg_gs_dump
  return "$_crg_gs_state_rc"
}
crg_git_selector_state
_crg_gs_rc=$?
if [ "$_crg_gs_rc" -eq 0 ]; then
  echo "[pre-commit] ERROR: an ambient Git selector is set (history, attribute, or ref-backend family; case-insensitive); refusing before repository inspection." >&2
  exit 1
fi
if [ "$_crg_gs_rc" -ne 1 ]; then
  echo "[pre-commit] ERROR: the process environment could not be enumerated while checking ambient Git selectors; refusing before repository inspection." >&2
  exit 1
fi
unset _crg_gs_rc _crg_gs_state_rc


# Retired project-mode authorization is inert. Git for Windows' sh keeps
# environment names case-sensitive, while child PowerShell resolves them
# case-insensitively. Remove every exported ASCII case variant without
# evaluating any environment value, then verify the child environment is clean.
crg_clear_retired_mode_env() {
  _crg_rme_dump=$(env 2>/dev/null) || return 1
  _crg_rme_names=$(printf '%s\n' "$_crg_rme_dump" | LC_ALL=C awk -F= '
    tolower($1) == "cross_review_allow_mode_change" { print $1 }
  ') || return 1
  unset CROSS_REVIEW_ALLOW_MODE_CHANGE
  for _crg_rme_name in $_crg_rme_names; do
    unset "$_crg_rme_name" || return 1
  done
  _crg_rme_after=$(env 2>/dev/null) || return 1
  _crg_rme_left=$(printf '%s\n' "$_crg_rme_after" | LC_ALL=C awk -F= '
    tolower($1) == "cross_review_allow_mode_change" { print $1 }
  ') || return 1
  [ -z "$_crg_rme_left" ] || return 1
  unset _crg_rme_dump _crg_rme_names _crg_rme_name _crg_rme_after _crg_rme_left
  return 0
}
if ! crg_clear_retired_mode_env; then
  echo "[pre-commit] ERROR: could not clear every case variant of the retired project-mode authorization variable; refusing before child execution." >&2
  exit 1
fi


# The follow-up index's capture doctrine. Every writer must emit byte-identical
# text so a reader sees one contract regardless of which gate wrote the file.
CROSS_REVIEW_FOLLOWUP_DOCTRINE_VERSION=6
# Exit 0 = the file already carries this writer's frame as the WINNING frame
# under the monotonic rule (or a NEWER version governs, which an older frame
# could not supersede); 1 = absent/stale/malformed (append); >=2 = unreadable,
# an UNKNOWN state the caller must not guess at. Supersession is monotonic BY
# VERSION -- the highest complete version wins wherever it sits, position only
# breaking ties within one version -- so a complete older frame appended below a
# newer one no longer forces a rewrite, and an unknown newer frame is left alone.
# CROSS-WRITER APPEND LOCK. The atomicity unit for this index is the WHOLE
# transaction -- header (when creating), doctrine frame (when migrating), and
# every row of one promotion -- because a row's meaning depends on the block
# header above it: the header carries the artifact LOCATOR that every row
# beneath it is read against, so an interleave that separates rows from their
# header leaves those rows pointing at another run's artifact or at nothing.
# ATOMICITY COMES FROM THE LOCK, not from any single write: the transaction is
# assembled in one buffer and streamed while the lock is held, which is what
# keeps a concurrent worktree's hook from interleaving into the middle of it --
# no `cat` or `printf` is atomic at any size. `mkdir` is the portable atomic
# test-and-set (it fails when the directory exists on every filesystem this runs
# on), so every writer of this index takes the SAME sidecar directory lock around
# its append.
# A lock nobody can release would disable appends forever, so acquisition writes
# an owner marker naming the holder, and a lock that cannot be taken within the
# retry budget DROPS this record with a WARN naming the lock, its marker and its
# age. An operator clears crash residue; nothing reclaims it automatically.
#
# NO AUTOMATIC TAKEOVER. Aging a lock out and reclaiming it -- by delete, and
# later by atomic rename-aside plus ownership tokens -- was built here and taken
# back out: in portable sh every step is a PATH check (`test`, `mkdir`, `mv`),
# and a path check reports what was true at some past instant, never what holds
# during the write that follows. A holder that resumes mid-reclaim cannot be
# fenced, so the reclaim could let two writers append at once -- the exact
# interleaving this lock exists to prevent. Do not rebuild it on path checks. It
# needs an OS-fenced primitive this hook does not have: an exclusive handle held
# across the whole critical section, or a lease with a fencing token the
# filesystem itself validates.

# The marker names the holder for diagnostics, and the release compares it
# byte-for-byte against the token this writer wrote. That catches a release whose
# token DIFFERS from the standing marker -- another process, or this one from a
# different second -- and stops exactly there. The token is a tag, a PID and a
# WHOLE-SECOND stamp, so one process reacquiring inside a single second writes
# byte-identical bytes and the comparison cannot separate those generations; a
# caller that held a token across its own release-and-reacquire would defeat it,
# which is why no caller here keeps one past the release it was acquired for.
# It is not an authenticity check and cannot be one: the marker sits at a
# workspace-readable path and its bytes are deterministic, so any process that
# can read it can reproduce it.
#
# ONE READ, and every consumer works from its snapshot: nothing downstream may
# open the marker a second time. Two reads of a path another process can rewrite
# between them would let the rendering and the release decision disagree about
# what was standing there.
#
# HEX, not raw text, because the snapshot has to survive command substitution --
# which drops NUL bytes and every trailing newline. Those are exactly the bytes a
# rendering must be able to announce and a comparison must be able to see.
#
# -L BEFORE -f, ON BOTH THE LOCK DIRECTORY AND THE MARKER: POSIX `-f` and `-d`
# DEREFERENCE, so a link at either level passes them and the read lands outside
# the lock. Classifying `owner` alone is not enough -- a link at `<index>.lock`
# redirects resolution before `owner` is ever examined, and an external target
# then looks perfectly regular.
#
# NO FALLIBLE STAGE HIDES BEHIND ANOTHER. A POSIX pipeline reports only its LAST
# stage, so `head | od | tr` returns zero even when the read failed: a first
# stage emitting the expected bytes and exiting nonzero still produced status 0
# carrying the full hex, which would have authorized a release on a failed read.
# So the file read is `od -N` reading the marker DIRECTLY, making the fallible
# I/O the command whose status the substitution reports, and every transformation
# after it lands in its own variable with its own check. What is left upstream of
# a checked stage is only `printf` of a string already in memory, whose sole
# failure mode is a write to a pipe whose reader has already died -- and that
# reader is the stage being checked. `pipefail` would cover the shape generically
# but is not portable across the shells this hook runs under, so nothing here
# depends on it.
#
# The node refusal is NOT absolute: the tests and the read are separate calls, so
# a node swapped between them is still read. Closing that needs a no-follow open
# this shell has no portable way to perform; the gate narrows the pre-existing
# window rather than removing it.
#
# Status: 2 = a node that must not be read, at EITHER level -- so something that
# is not a directory standing where the lock belongs reports a refusal rather
# than absence, which is also what the .NET readers report for that node. 3 = a
# read or an encode this shell could not complete, INCLUDING a traversal that
# could not prove absence: `test` answers false for a node it cannot reach
# exactly as it does for one that is not there, so an unsearchable parent
# reports 3 rather than an absence the release would go on to word as another
# writer's ownership. 1 = nothing there, across a parent this reader could
# search. 0 = a snapshot on stdout, empty only for a zero-byte marker.
#
# ONE constant for the bound, read here and enforced by the comparison in
# crg_followup_lock_marker_matches. Declaring the cap twice is how a reader and
# its length guard drift apart, and a guard that disagrees with the read it
# guards admits exactly the prefix it exists to reject.
CROSS_REVIEW_FOLLOWUP_MARKER_CAP=512

# Bare lowercase hex from a raw `od -tx1` dump, WITHOUT a pipeline. A pipeline
# assignment reports only its LAST command, so a producer interrupted mid-write
# hands the consumer a prefix while the consumer still exits 0 -- and a prefix
# that reaches the expected token's length compares EQUAL, authorizing the
# removal of a lock whose tail was never read. That is the same prefix
# acceptance the cap guard exists to refuse, arriving through the producer
# instead of through the bound. Word-splitting drops od's spacing with no
# process that can fail, and the alphabet check is what lets the fold use a
# here-doc: it proves the text carries none of the characters an unquoted
# here-doc would expand.
crg_followup_hex_normalize() {
  _crg_hnb=''
  for _crg_hnw in $1; do
    _crg_hnb="$_crg_hnb$_crg_hnw"
  done
  case "$_crg_hnb" in
    *[!0-9A-Fa-f]*) return 3 ;;
  esac
  # STAGED rather than printed as the tail of the function. A failing final
  # stage would otherwise hand its own status to the caller, where only 1, 2 and
  # 3 carry meaning and a 1 reads as ABSENCE -- a claim a transform that broke
  # over bytes that were present is never entitled to make.
  _crg_hnc=$(LC_ALL=C tr 'A-F' 'a-f' <<CRG_FOLLOWUP_HEX_FOLD
$_crg_hnb
CRG_FOLLOWUP_HEX_FOLD
) || return 3
  printf '%s' "$_crg_hnc"
}

crg_followup_lock_marker_hex() {
  [ -L "$1" ] && return 2
  if [ -e "$1" ] && [ ! -d "$1" ]; then return 2; fi
  if [ ! -d "$1" ]; then
    # ABSENCE HAS TO BE EARNED. Without a searchable parent, "nothing here" is a
    # claim this reader cannot make -- and the release turns a 1 into ownership
    # wording, so an access error would be reported as another writer's lock.
    _crg_hxp=${1%/*}
    case "$_crg_hxp" in
      "$1") _crg_hxp=. ;;
      '')   _crg_hxp=/ ;;
    esac
    # BOTH tests, because `-x` alone answers for a regular file too: an
    # executable file standing where a parent belongs satisfies it while being
    # unsearchable, which would report absence this reader never established.
    if [ ! -d "$_crg_hxp" ] || [ ! -x "$_crg_hxp" ]; then return 3; fi
    return 1
  fi
  [ -L "$1/owner" ] && return 2
  if [ -e "$1/owner" ] && [ ! -f "$1/owner" ]; then return 2; fi
  if [ ! -f "$1/owner" ]; then
    [ -x "$1" ] || return 3
    return 1
  fi
  _crg_hxa=$(LC_ALL=C od -An -v -tx1 -N "$CROSS_REVIEW_FOLLOWUP_MARKER_CAP" "$1/owner" 2>/dev/null) || return 3
  _crg_hxc=$(crg_followup_hex_normalize "$_crg_hxa") || return 3
  printf '%s' "$_crg_hxc"
}

# The release compares the WHOLE marker against what acquisition wrote: the token
# plus its single LF terminator. A trimmed prefix would accept a marker whose tail
# was rewritten, and the tail is what an editor of this path controls. The
# snapshot is bounded well above any token, so an oversized marker encodes to more
# hex than the token accounts for and mismatches instead of passing as a prefix.
crg_followup_lock_marker_matches() {
  [ -n "$2" ] || return 1
  # An unquoted here-doc expands exactly three characters, so a token carrying
  # any of them is refused rather than encoded. Acquisition never writes one,
  # and the alternative -- piping the token into od -- is the producer-masking
  # shape this protocol just removed.
  case "$2" in
    *'$'*|*'`'*|*'\'*)
      echo "[pre-commit] WARN: the marker to compare carries a character this shell cannot encode without a pipeline - refusing the release rather than guessing" >&2
      return 3 ;;
  esac
  # od is the SOLE command here: the here-doc supplies the token and its single
  # LF terminator from the shell itself -- the same bytes acquisition wrote --
  # so there is no separate producer whose failure the assignment could discard.
  _crg_mexp=$(LC_ALL=C od -An -v -tx1 <<CRG_FOLLOWUP_TOKEN_HEX
$2
CRG_FOLLOWUP_TOKEN_HEX
) || _crg_mexp=''
  if [ -n "$_crg_mexp" ]; then
    _crg_mexp=$(crg_followup_hex_normalize "$_crg_mexp") || _crg_mexp=''
  fi
  if [ -z "$_crg_mexp" ]; then
    # A token this writer holds always encodes to something, so an empty
    # encoding is a broken toolchain, not a marker mismatch. The refusal is the
    # same either way -- nothing is removed -- but the reason has to say which.
    echo "[pre-commit] WARN: could not hex-encode the owner marker for comparison (is 'od' present?) - refusing the release rather than guessing" >&2
    return 3
  fi
  # REFUSED AT THE CAP, not merely past it. The snapshot below stops at
  # CROSS_REVIEW_FOLLOWUP_MARKER_CAP bytes, so an expectation that reaches
  # exactly that length is indistinguishable from the same bytes followed by
  # anything else: the read ends before the divergence and a PREFIX compares
  # equal, which would authorize deleting a lock whose tail this writer never
  # wrote. A marker that cannot be confirmed INSIDE the bound is therefore
  # refused rather than compared against a truncation, matching the PowerShell
  # writers.
  if [ "${#_crg_mexp}" -ge "$((CROSS_REVIEW_FOLLOWUP_MARKER_CAP * 2))" ]; then
    echo "[pre-commit] WARN: the marker to compare cannot be confirmed inside the bounded read - refusing the release rather than accepting a prefix" >&2
    return 3
  fi
  # STATUS IS STRUCTURED, not collapsed. A node this reader refuses (2) and a read
  # it could not complete (3) are NOT the same claim as "these bytes differ" (1):
  # only the last one says anything about ownership. Folding them together made a
  # transient read fault present as another writer's lock, which sends an operator
  # looking for a holder that was never there while the lock stands.
  _crg_mgot=$(crg_followup_lock_marker_hex "$1")
  _crg_mrc=$?
  [ "$_crg_mrc" -eq 2 ] && return 2
  [ "$_crg_mrc" -eq 3 ] && return 3
  [ "$_crg_mrc" -eq 0 ] || return 1
  [ -n "$_crg_mgot" ] || return 1
  [ "$_crg_mgot" = "$_crg_mexp" ]
}

# Display form, PRINTABLE-ASCII WHITELIST: printable ASCII passes and every other
# byte is dropped -- ASCII controls (NUL included) as much as C1 controls, the
# UTF-8 bytes of bidi overrides and separators, and everything non-ASCII -- with
# the removal ANNOUNCED so the rendering never implies the marker said only what
# survived. Another process's bytes reach an operator's terminal through here, and
# a blacklist keeps losing to the next character class nobody enumerated. (The
# .NET writers escape those bytes as \uXXXX instead of dropping them; both are the
# same whitelist decision, and only sh lacks a portable per-character escape.)
crg_followup_lock_marker_display() {
  _crg_mhex=$(crg_followup_lock_marker_hex "$1")
  # A read this shell could not complete is NOT absence. Rendering it as 'no
  # marker' would deny a holder that may well be standing there, and it is the
  # state the .NET readers announce as '[unreadable marker]' -- an operator
  # reading either runtime's WARN meets one phrase for one state.
  case "$?" in
    2) printf '[unreadable marker: not a regular file]'; return 0 ;;
    3) printf '[unreadable marker]'; return 0 ;;
    1) printf 'no marker'; return 0 ;;
  esac
  [ -n "$_crg_mhex" ] || { printf 'no marker'; return 0; }
  # Rendered from the SNAPSHOT's bytes, so every dropped byte is visible to the
  # announcement -- including NUL, which command substitution of the raw text
  # would have removed before anything could notice it was there.
  printf '%s' "$_crg_mhex" | LC_ALL=C awk '
    {
      hex = $0
      out = ""
      dropped = 0
      n = int(length(hex) / 2)
      for (i = 0; i < n; i++) {
        hi = index("0123456789abcdef", substr(hex, i * 2 + 1, 1)) - 1
        lo = index("0123456789abcdef", substr(hex, i * 2 + 2, 1)) - 1
        v = hi * 16 + lo
        # The rendering is ONE line, so the first line break ends it -- the same
        # boundary the .NET writers stop at.
        if (v == 10 || v == 13) break
        if (v >= 32 && v <= 126) {
          if (length(out) < 120) out = out sprintf("%c", v)
        } else {
          dropped = 1
        }
      }
      if (out == "") {
        # An all-hostile marker cleans to nothing. Reporting that as absence
        # would hide the very removal this rendering exists to announce.
        printf "%s", (dropped ? "[marker unprintable: every byte removed]" : "no marker")
      } else if (dropped) {
        printf "%s [non-printable bytes removed]", out
      } else {
        printf "%s", out
      }
    }'
}

crg_followup_lock_age_display() {
  _crg_now=$(date +%s 2>/dev/null || echo 0)
  _crg_then=$(date -r "$1" +%s 2>/dev/null)
  case "$_crg_then" in
    ''|*[!0-9]*) printf 'unknown'; return 0 ;;
  esac
  [ "$_crg_now" -gt 0 ] || { printf 'unknown'; return 0; }
  printf '%ss' "$((_crg_now - _crg_then))"
}

# Prints the marker this writer wrote; the caller passes it back to the release
# so a writer cannot remove a lock it does not hold. A failed acquisition prints
# nothing.
crg_followup_lock_acquire() {
  _crg_lock="$1.lock"
  _crg_budget=${2:-10}
  _crg_tries=0
  _crg_self="pre-commit:$$:$(date +%s 2>/dev/null || echo 0)"
  while [ "$_crg_tries" -lt "$_crg_budget" ]; do
    if mkdir "$_crg_lock" 2>/dev/null; then
      _crg_mine="$(date +%s 2>/dev/null || echo 0) $_crg_self"
      if printf '%s\n' "$_crg_mine" > "$_crg_lock/owner" 2>/dev/null; then
        printf '%s' "$_crg_mine"
        return 0
      fi
      echo "[pre-commit] WARN: could not write the owner marker in $_crg_lock - releasing the markerless lock and retrying" >&2
      rmdir "$_crg_lock" 2>/dev/null || echo "[pre-commit] WARN: could not remove $_crg_lock after a failed acquisition - remove it by hand" >&2
    fi
    _crg_tries=$((_crg_tries + 1))
    sleep 1
  done
  echo "[pre-commit] WARN: could not take the follow-up index lock at $_crg_lock (holder: '$(crg_followup_lock_marker_display "$_crg_lock")', age $(crg_followup_lock_age_display "$_crg_lock")) - dropping this follow-up record; follow-up recording is best-effort and the gate continues to its terminal identity check. If no writer is alive, remove that directory by hand: nothing reclaims it automatically." >&2
  return 1
}

crg_followup_lock_release() {
  _crg_lock="$1.lock"
  if [ -z "$2" ]; then
    echo "[pre-commit] WARN: release of $_crg_lock called without a marker - removing nothing" >&2
    return 1
  fi
  crg_followup_lock_marker_matches "$_crg_lock" "$2"
  _crg_relrc=$?
  if [ "$_crg_relrc" -ne 0 ]; then
    # Only a byte MISMATCH licenses the ownership wording. A refused node or a
    # failed read means this writer never learned whose lock it is, and saying
    # otherwise sends an operator hunting a holder the reader never saw.
    if [ "$_crg_relrc" -eq 1 ]; then
      echo "[pre-commit] WARN: $_crg_lock does not carry this writer's marker - removing nothing" >&2
    else
      echo "[pre-commit] WARN: the owner marker in $_crg_lock could not be read for comparison - removing nothing; the lock stays until a reader can confirm it or an operator clears it" >&2
    fi
    return 1
  fi
  rm -f "$_crg_lock/owner" 2>/dev/null
  if rmdir "$_crg_lock" 2>/dev/null; then return 0; fi
  echo "[pre-commit] WARN: could not release the follow-up index lock at $_crg_lock - appends stay blocked until it is removed by hand" >&2
  return 1
}

# The transaction buffer lives INSIDE the lock directory this writer holds, under
# an mktemp-random name: no other process can predict or pre-create the path to
# steer the write, and the object is confirmed to be a regular file and not a
# symlink before a byte goes through it.
crg_followup_tx_create() {
  _crg_txp=$(mktemp "$1/tx.XXXXXXXX" 2>/dev/null) || return 1
  if [ -L "$_crg_txp" ] || [ ! -f "$_crg_txp" ]; then
    echo "[pre-commit] WARN: the follow-up transaction buffer at $_crg_txp is not a regular file - refusing to write through it" >&2
    rm -f "$_crg_txp" 2>/dev/null
    return 1
  fi
  printf '%s' "$_crg_txp"
}

# Is the index's last transaction COMPLETE? Every writer ends its transaction with
# a line break, so a nonempty index whose final byte is not one was cut off
# mid-write. 0 = terminated, 1 = torn, 2 = the answer could not be established.
#
# The tail is STAGED and compared as BYTES rather than captured: command
# substitution strips trailing newlines, so an LF tail and an empty one would read
# identically, and it drops NUL bytes -- both answer TERMINATED for a tail that is
# not one, the single answer that buries a torn write. The comparison against a
# literal LF is the whole test, and it matches the PowerShell writers' rule byte
# for byte (LF only: a CRLF index still ends in LF, and no writer emits a bare CR),
# so the runtimes accept exactly the same tails. In the one
# pipeline here the surviving status is cmp's, and a failed printf feeds cmp an
# empty stdin, which MISMATCHES -- this comparison's only failure direction is
# toward refusing the append.
crg_followup_index_is_terminated() {
  [ -r "$1" ] || return 2
  # An EMPTY index has no transaction that could have been cut off, so it is
  # APPENDABLE -- and the runtimes have to say so with one voice or the parity
  # claim above is false: the PowerShell predicate answers terminated at length
  # zero, while the byte comparison below would see an empty tail, fail to match a
  # literal LF, and call an untouched file torn. The promotion path happens to
  # branch on emptiness before reaching here, so this arm is about the helper's own
  # contract holding for every caller rather than about the caller it has today.
  [ -s "$1" ] || return 0
  _crg_t_tmp=$(mktemp 2>/dev/null) || return 2
  if [ -L "$_crg_t_tmp" ] || [ ! -f "$_crg_t_tmp" ]; then
    rm -f "$_crg_t_tmp"
    return 2
  fi
  if ! tail -c 1 "$1" > "$_crg_t_tmp" 2>/dev/null; then
    rm -f "$_crg_t_tmp"
    return 2
  fi
  # cmp's three-way status is preserved: 0 = LF tail (terminated), 1 = a
  # real byte mismatch (torn), >1 = cmp itself TROUBLED (I/O error, missing
  # operand) -- an indeterminate probe, returned as 2 so the caller's
  # cannot-verify path (retry/refuse) handles it instead of the torn path
  # silently dropping the record.
  printf '\n' | cmp -s - "$_crg_t_tmp" 2>/dev/null
  _crg_t_cmp=$?
  rm -f "$_crg_t_tmp"
  if [ "$_crg_t_cmp" -eq 0 ]; then
    return 0
  fi
  if [ "$_crg_t_cmp" -eq 1 ]; then
    return 1
  fi
  return 2
}

crg_followup_frame_is_current() {
  [ -r "$1" ] || return 2
  # Versions are compared as DIGIT STRINGS (length, then lexicographic) inside
  # awk: a version larger than the shell's integer range would make `[ -gt ]`
  # fail with a syntax error, and awk's own numeric coercion would round two
  # distinct huge versions onto one double. Marker lines are matched with the CR
  # tolerated, but the frame BYTES below are compared raw -- the PowerShell
  # validators keep the CR in the frame they extract, so stripping it here would
  # make the two sides disagree on a CRLF-line-ended index.
  _crg_state=$(awk -v sup="$CROSS_REVIEW_FOLLOWUP_DOCTRINE_VERSION" '
    function normv(s) { sub(/^0+/, "", s); if (s == "") s = "0"; return s }
    function vgt(a, b) { if (length(a) != length(b)) return length(a) > length(b); return (a > b) }
    { line = $0; sub(/\r$/, "", line) }
    line ~ /^<!-- review-followups: capture-doctrine v[0-9]+ BEGIN -->$/ {
      v = line
      sub(/^<!-- review-followups: capture-doctrine v/, "", v)
      sub(/ BEGIN -->$/, "", v)
      open[normv(v)] = NR
      next
    }
    line ~ /^<!-- review-followups: capture-doctrine v[0-9]+ END -->$/ {
      v = line
      sub(/^<!-- review-followups: capture-doctrine v/, "", v)
      sub(/ END -->$/, "", v)
      v = normv(v)
      if (open[v] > 0) {
        if (maxv == "" || vgt(v, maxv) || v == maxv) { maxv = v; beg = open[v]; end = NR }
        open[v] = 0
      }
      next
    }
    END {
      if (maxv == "") { print "none 0 0"; exit }
      s = normv(sup)
      print (vgt(maxv, s) ? "newer" : (maxv == s ? "same" : "older")) " " beg + 0 " " end + 0
    }
  ' "$1" 2>/dev/null) || return 2
  _crg_kind=${_crg_state%% *}
  _crg_rest=${_crg_state#* }
  _crg_beg=${_crg_rest%% *}
  _crg_end=${_crg_rest##* }
  case "$_crg_beg$_crg_end" in
    ''|*[!0-9]*) return 2 ;;
  esac
  case "$_crg_kind" in
    none)  return 1 ;;
    older) return 1 ;;
    newer) return 0 ;;
    same)  ;;
    *)     return 2 ;;
  esac
  # tail then head, coreutils rather than awk: the awk build Git for Windows
  # ships reads in TEXT mode and silently drops CR bytes, which would make this
  # side call a CRLF index CURRENT while the PowerShell validators (which see the
  # raw bytes) call the same file STALE. The extraction runs SEQUENTIALLY
  # through a temp file rather than piped: in a pipeline only the LAST stage's
  # status survives, so a failing tail would look like an empty frame and take
  # the stale-append path instead of the unknown-state path, and appending under
  # an unverified contract is the one outcome this function exists to prevent.
  _crg_count=$((_crg_end - _crg_beg + 1))
  _crg_tmp=$(mktemp 2>/dev/null) || return 2
  if [ -L "$_crg_tmp" ] || [ ! -f "$_crg_tmp" ]; then
    rm -f "$_crg_tmp"
    return 2
  fi
  if ! tail -n +"$_crg_beg" "$1" > "$_crg_tmp" 2>/dev/null; then
    rm -f "$_crg_tmp"
    return 2
  fi
  _crg_last_frame=$(head -n "$_crg_count" "$_crg_tmp" 2>/dev/null)
  _crg_head_rc=$?
  rm -f "$_crg_tmp"
  [ "$_crg_head_rc" -eq 0 ] || return 2
  [ -n "$_crg_last_frame" ] || return 1
  # The frame proper: leading blank line dropped by sed, trailing blank lines by
  # the command substitution -- the same trim the PowerShell side applies with
  # .Trim(CR, LF), so the two compare the same span.
  #
  # STAGED AND CHECKED, never a pipeline. A `printf | sed` assignment reports only
  # the LAST stage, so a failing `sed` yields an empty or partial expectation and
  # the comparison below then returns 1 -- and 1 means STALE here, which sends the
  # caller down the APPEND path. That is a transformer failure authorizing a write
  # to the index under a contract this function never actually verified: the one
  # outcome it exists to prevent. Each producer therefore lands in its own object
  # with its own check, and every failure answers 2 (UNKNOWN) so the caller stops
  # instead of guessing -- the same discipline crg_followup_hex_normalize applies
  # to its own staged transform.
  _crg_exp_tmp=$(mktemp 2>/dev/null) || return 2
  if [ -L "$_crg_exp_tmp" ] || [ ! -f "$_crg_exp_tmp" ]; then
    rm -f "$_crg_exp_tmp"
    return 2
  fi
  if ! printf '%s' "$CROSS_REVIEW_FOLLOWUP_CAPTURE_DOCTRINE" > "$_crg_exp_tmp" 2>/dev/null; then
    rm -f "$_crg_exp_tmp"
    return 2
  fi
  _crg_expected=$(sed -e '/./,$!d' "$_crg_exp_tmp" 2>/dev/null)
  _crg_exp_rc=$?
  rm -f "$_crg_exp_tmp"
  [ "$_crg_exp_rc" -eq 0 ] || return 2
  # A frame this writer holds always trims to something. An EMPTY expectation is a
  # broken toolchain, not a stale index, and comparing against it would call every
  # index stale and re-append the frame forever.
  [ -n "$_crg_expected" ] || return 2
  [ "$_crg_last_frame" = "$_crg_expected" ] || return 1
  return 0
}
